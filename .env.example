# =============================================================================
# API Keys
# =============================================================================
# Required: at least one model provider key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: additional model providers
COHERE_API_KEY=
MISTRAL_API_KEY=

# Optional: Bedrock (uses AWS credential chain, or set explicitly)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1

# Search API (required for research)
TAVILY_API_KEY=

# Observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# =============================================================================
# Model Slot Overrides (optional, override config.json values)
# =============================================================================
# These let you swap models without editing config.json.
# Format: provider:model_name (e.g., openai:gpt-4o, anthropic:claude-sonnet-4-20250514)
# RESEARCH_MODEL=openai:gpt-4.1
# SUMMARIZATION_MODEL=openai:gpt-4.1-mini
# COMPRESSION_MODEL=openai:gpt-4.1
# FINAL_REPORT_MODEL=openai:gpt-4.1
# CLASSIFIER_MODEL=

# =============================================================================
# Config File (optional)
# =============================================================================
# Explicit path to config.json for installed deployments (wheels, Docker).
# Not needed for source checkouts — config.json is loaded from package root.
# ODR_CONFIG_FILE=/path/to/config.json

# =============================================================================
# Open Agent Platform (optional)
# =============================================================================
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform.
GET_API_KEYS_FROM_CONFIG=false
