      "default_model": "gemini-2.5-flash",
      "aliases": ["google"],
      "api_key_env": "GOOGLE_API_KEY",
      "allowed_models": [
        "gemini-2.5-pro", "gemini-2.5-flash",
        "gemini-1.5-pro", "gemini-1.5-flash"
